{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["lib/**/*.ts", "beispiel/tests/**/*.ts", "projects/*/tests/**/*.ts", "playwright.config.ts"]
}
