# Vorlage für .env: kopieren nach .env und Werte direkt hinter das "=" schreiben.
# Leer gelassene Variablen gelten als nicht gesetzt (dann greift die Vorgabe).
# Zeilen mit "#" am Anfang sind Kommentare: Ein Wert dort wirkt nicht.
#
# .env füllst nur Du aus. Sie wird nicht eingecheckt und vom Agent nicht beschrieben.
# Der Agent ergänzt hier die Variablennamen, die seine Tests brauchen, und sagt Dir,
# was Du in .env eintragen musst. Tests lesen die Werte über process.env.
#
# Testdaten aus einer Aufzeichnung im Modus "full" kann das Analyse-Script in
# testdaten.aufzeichnung.env übernehmen. Was hier in .env steht, hat Vorrang.

# Startadresse der zu testenden Website, z. B. https://www.example.de (Pflicht)
BASE_URL=

# Modus für Tests ohne eigene Angabe (Vorgabe: abfangen)
#   abfangen: Requests werden protokolliert, aber nie gesendet
#   blockieren: Requests werden abgebrochen, wie durch einen Adblocker
#   durchlassen: Requests gehen wirklich raus
# Baseline-Tests setzen "durchlassen" selbst, unabhängig von diesem Wert.
TRACKING_MODUS=

# Pausen zwischen den Schritten: schnell (Vorgabe), mittel, langsam, aufzeichnung
# (wie aufgezeichnet). Zeitabhängige Requests wie GA4 user_engagement hängen davon ab.
TEMPO=

# Requests über den Stage-Proxy führen: ein / aus (Vorgabe: aus).
# Mit Proxy sind auch Beacons beim Verlassen einer Seite und Service-Worker-Requests sichtbar
# und abfangbar; Service Worker laufen dann wie bei echten Besuchern.
PROXY=

# aus: Tests enden vor der Aktion, die die Conversion auslöst (Kauf, Absenden), und gelten
# als übersprungen. Für das Einrichten der Tests, damit nichts Echtes abgeschickt wird. Vorgabe: ein.
CONVERSION=

# abfangen: Fetch-, XHR- und Beacon-Requests ohne Regel an fremde Domains wie Tracking behandeln
# (Dienst "Unbekannt"). Sicherheitsnetz gegen unbekannte Endpunkte; kann Funktionen der Website stören.
UNBEKANNTE=

# Nur bei Tests gegen eine GTM-Vorschau: Link aus GTM „Vorschau“ bzw. „Vorschau teilen“
# (tagassistant.google.com/…&gtm_auth=…). Enthält einen Zugangsschlüssel, daher hier statt im Code.
GTM_VORSCHAU_LINK=

# Basic Auth der Website (z. B. Staging hinter .htaccess)
BASIC_AUTH_BENUTZER=
BASIC_AUTH_PASSWORT=

# Testkonto (z. B. eines, dessen Bestellungen automatisch storniert werden).
# Passwörter zeichnet der Recorder nie auf; sie gehören immer hierher.
TEST_LOGIN_EMAIL=
TEST_LOGIN_PASSWORT=

# Testdaten für Formulare. Für Enhanced Conversions o. Ä. eigene Testadressen verwenden.
TEST_EMAIL=
TEST_TELEFON=
