{
  "name": "tracking-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:sichtbar": "playwright test --headed",
    "analyse": "node --max-old-space-size=4096 werkzeuge/analysiere-aufzeichnung.mjs",
    "baseline:neu": "playwright test --update-snapshots",
    "report": "playwright show-report",
    "pruefen": "tsc -p ."
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.14",
    "node-forge": "^1.4.3",
    "typescript": "^5.6.0"
  }
}
