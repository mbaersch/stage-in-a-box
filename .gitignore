# Allowlist: Nur die hier freigegebenen Dateien und Ordner gehören ins Repo.
# Neue Dateien oder Ordner auf oberster Ebene hier freigeben.
/*
!/.gitignore
!/README.md
!/LICENSE
!/AGENTS.md
!/CLAUDE.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/playwright.config.ts
!/build.sh
!/dist/
!/src/
!/test/
!/lib/
!/werkzeuge/
!/docs/
!/beispiel/
!/vorlage/
!/res/

# Projekte mit Aufzeichnungen, .env und Reports: nie einchecken, auch wenn die Allowlist sich ändert
/projects/
# Heruntergeladene Extensions (npm run erweiterung)
/erweiterungen/

# Erzeugte Dateien
node_modules/
test-results/
playwright-report/
__pycache__/
test/beispielausgabe.json
*.stackdump
