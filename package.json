{
  "name": "stage-in-a-box",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:sichtbar": "playwright test --headed",
    "neu": "node werkzeuge/neues-projekt.mjs",
    "analyse": "node --max-old-space-size=4096 werkzeuge/analysiere-aufzeichnung.mjs",
    "baseline:neu": "playwright test --update-snapshots=all",
    "report": "playwright show-report",
    "pruefen": "node werkzeuge/pruefen.mjs",
    "test:recorder": "node test/recorder-smoke.mjs",
    "sitzung": "playwright test --headed --workers=1 -g @sitzung",
    "aufnahme": "playwright test --headed --workers=1 -g @aufnahme",
    "abnahme": "node werkzeuge/abnahme.mjs",
    "erweiterung": "node werkzeuge/erweiterung-holen.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.14",
    "node-forge": "^1.4.3",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "@ghostery/adblocker": "^2.20.3"
  }
}
