{
  "name": "stage-in-a-box",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:sichtbar": "playwright test --headed",
    "neu": "node werkzeuge/neues-projekt.mjs",
    "analyse": "node --max-old-space-size=4096 werkzeuge/analysiere-aufzeichnung.mjs",
    "baseline:neu": "playwright test --update-snapshots=all",
    "report": "playwright show-report",
    "pruefen": "tsc -p .",
    "test:recorder": "node test/recorder-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.14",
    "node-forge": "^1.4.3",
    "typescript": "^5.6.0"
  }
}
